{
  "name": "redact-secret-adapters",
  "version": "0.0.0",
  "private": true,
  "description": "Host integrations for Redact Secret: logging, tracing, and AI-context adapters over the deterministic core.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/redact-secret/redact-secret-adapters.git"
  },
  "engines": {
    "node": "20.x || 22.x || 24.x"
  },
  "workspaces": [
    "packages/adapter",
    "packages/adapter-pino",
    "packages/adapter-otel-trace",
    "packages/adapter-otel",
    "packages/adapter-otel-logs",
    "packages/adapter-ai-context",
    "packages/adapter-mcp"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "lint": "biome check .",
    "format": "biome check --write .",
    "range-endpoint": "node scripts/install-range-endpoint.mjs",
    "verify-pack-contents": "node scripts/verify-pack-contents.mjs",
    "smoke-test": "node scripts/smoke-test-npm-packages.mjs",
    "smoke-test:platform": "node scripts/smoke-test-platform.mjs",
    "smoke-test:browser": "node scripts/smoke-test-browser-ai-context.mjs",
    "smoke-test:otel-logs": "node scripts/smoke-test-otel-logs.mjs",
    "published-combination": "node scripts/check-published-combination.mjs",
    "support-summary": "node scripts/support-summary.mjs",
    "compat:check": "node scripts/check-compatibility-record.mjs",
    "overhead": "node scripts/measure-overhead.mjs",
    "footprint": "node scripts/measure-footprint.mjs",
    "bench:docker": "node scripts/bench-docker.mjs",
    "feed:generate": "node scripts/generate-site-feed.mjs",
    "examples:check": "node scripts/check-examples.mjs",
    "examples:run": "node scripts/check-examples.mjs --run",
    "testbed": "node testbed/run.mjs",
    "testbed:check": "node testbed/scripts/check-pack-isolation.mjs && node testbed/scripts/check-registry.mjs",
    "testbed:test": "node --test testbed/test/*.test.mjs",
    "feed:check": "node scripts/generate-site-feed.mjs --check"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/node": "^20.19.0",
    "@vitest/coverage-v8": "^4.1.11",
    "ajv": "^8.20.0",
    "esbuild": "0.28.2",
    "fast-check": "4.10.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
