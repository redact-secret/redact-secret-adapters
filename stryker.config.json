{
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.stryker.config.ts"
  },
  "checkers": [],
  "disableTypeChecks": "packages/*/{src,test}/**/*.{js,ts,mts,cts}",
  "coverageAnalysis": "perTest",
  "reporters": ["clear-text", "json"],
  "jsonReporter": {
    "fileName": "reports/mutation/mutation.json"
  },
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": true,
  "timeoutMS": 30000,
  "concurrency": 4,
  "ignorePatterns": [".claude", ".agents", "graft", "python", "site-feed"]
}
