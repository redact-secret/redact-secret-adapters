    "url": "https://github.com/redact-secret/redact-secret-adapters/issues"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@redact-secret/adapter": "^0.1.7"
  },
  "peerDependencies": {
    "@opentelemetry/sdk-logs": ">=0.200.0 <=0.222.0",
