{
  "name": "@redact-secret/adapter-otel-logs",
  "version": "0.1.0-beta.2",
  "description": "A redacting OpenTelemetry JS LogRecordProcessor (logs only) over the Redact Secret core.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
