  },
  "devDependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/otlp-transformer": "^0.222.0",
    "@opentelemetry/sdk-logs": ">=0.200.0 <=0.222.0",
    "@redact-secret/core": "^0.1.0-beta.6"
  }
